# Source from Bash to select the physical Go2 communication service.
unitree_real_repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ -f "$unitree_real_repo/.env.local" ]]; then
    source "$unitree_real_repo/.env.local"
fi
export RPENT_UNITREE_MODE=real
export RPENT_CONFIG_FILE="$unitree_real_repo/robots/unitree/real_local.env"
export RPENT_VENV_DIR="${RPENT_VENV_DIR:-$unitree_real_repo/../.venv}"
export RPENT_REAL_ENDPOINT="${RPENT_REAL_ENDPOINT:-http://127.0.0.1:9001}"
export RPENT_RUNS_DIR="$unitree_real_repo/output/real-integration/runs"
export RPENT_MEMORY_DIR="$unitree_real_repo/output/real-integration/memory"
unset unitree_real_repo
